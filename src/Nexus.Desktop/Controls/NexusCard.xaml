<UserControl x:Class="Nexus.Desktop.Controls.NexusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{StaticResource NexusSurfaceBrush}"
            BorderBrush="{StaticResource NexusBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="{Binding CardPadding, ElementName=Root}">
        <ContentPresenter Content="{Binding CardContent, ElementName=Root}"/>
    </Border>
</UserControl>
