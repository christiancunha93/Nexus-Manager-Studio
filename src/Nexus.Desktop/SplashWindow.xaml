<Window x:Class="Nexus.Desktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180"
        Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NexusBackgroundBrush}"
        AllowsTransparency="True"
        Opacity="0">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.43"
                                 GradientOrigin="0.5,0.43"
                                 RadiusX="0.75"
                                 RadiusY="0.75">
                <GradientStop Color="#173A2B" Offset="0"/>
                <GradientStop Color="#0B1118" Offset="0.58"/>
                <GradientStop Color="#070B10" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="NEXUS"
                       Foreground="{StaticResource NexusTextBrush}"
                       FontSize="76"
                       FontWeight="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="MANAGER"
                       Foreground="{StaticResource NexusAccentBrush}"
                       FontSize="23"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,38"/>

            <TextBlock x:Name="LoadingStatusText"
                       Text="Inicializando núcleo..."
                       Foreground="{StaticResource NexusMutedBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <ProgressBar x:Name="LoadingProgressBar"
                         Width="360"
                         Height="5"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Background="#263441"
                         Foreground="{StaticResource NexusAccentBrush}"
                         BorderThickness="0"/>
        </StackPanel>

        <TextBlock Text="PROJETO GENESIS • SPRINT 009"
                   Foreground="#638075"
                   FontSize="10"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,26"/>
    </Grid>
</Window>
