<Window x:Class="Nexus.Desktop.WorldGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criando Universo"
        Width="1040"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource NexusBackgroundBrush}">

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.44"
                                 GradientOrigin="0.5,0.44"
                                 RadiusX="0.78"
                                 RadiusY="0.78">
                <GradientStop Color="#173A2B" Offset="0"/>
                <GradientStop Color="#0B1118" Offset="0.58"/>
                <GradientStop Color="#070B10" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="CRIANDO UNIVERSO"
                       FontSize="38"
                       FontWeight="Black"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="GenerationStatusText"
                       Text="Preparando a estrutura do mundo..."
                       Foreground="{StaticResource NexusMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,24"/>

            <ProgressBar x:Name="GenerationProgressBar"
                         Height="7"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{StaticResource NexusAccentBrush}"
                         Background="{StaticResource NexusSurfaceAltBrush}"
                         BorderThickness="0"/>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ClubsCountText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="CLUBES"
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PlayersCountText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="JOGADORES"
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="NewsCountText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Black"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="NOTÍCIAS"
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Cada save do Nexus possui um universo independente."
                       Foreground="#638075"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"/>
        </StackPanel>
    </Grid>
</Window>
