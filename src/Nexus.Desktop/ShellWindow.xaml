<Window x:Class="Nexus.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Manager Studio"
        Width="1500"
        Height="860"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NexusBackgroundBrush}">

    <Grid Background="{StaticResource NexusBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource NexusSurfaceBrush}"
                BorderBrush="{StaticResource NexusBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="22,26,22,18">
                    <TextBlock Text="NEXUS"
                               FontSize="28"
                               FontWeight="Black"/>
                    <TextBlock Text="MANAGER STUDIO"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="14,18">
                    <TextBlock Text="CARREIRA ATIVA"
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="ManagerNameText"
                               Text="Treinador"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,8,0,2"/>
                    <TextBlock x:Name="ClubSeasonText"
                               Text="Clube • 2026"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="12"/>

                    <Separator Background="{StaticResource NexusBorderBrush}"
                               Margin="0,22"/>

                    <TextBlock Text="Painel" FontSize="15" FontWeight="SemiBold" Margin="0,8"/>
                    <TextBlock Text="Clube" Foreground="{StaticResource NexusMutedBrush}" FontSize="15" Margin="0,8"/>
                    <TextBlock Text="Elenco" Foreground="{StaticResource NexusMutedBrush}" FontSize="15" Margin="0,8"/>
                    <TextBlock Text="Calendário" Foreground="{StaticResource NexusMutedBrush}" FontSize="15" Margin="0,8"/>
                    <TextBlock Text="Competições" Foreground="{StaticResource NexusMutedBrush}" FontSize="15" Margin="0,8"/>
                    <TextBlock Text="Nexus News" Foreground="{StaticResource NexusMutedBrush}" FontSize="15" Margin="0,8"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="SPRINT 009 • WORLD"
                           Foreground="{StaticResource NexusAccentBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource NexusSurfaceBrush}"
                    BorderBrush="{StaticResource NexusBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PAINEL DA CARREIRA"
                                   FontSize="21"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentDateText"
                                   Text="05/01/2026"
                                   Foreground="{StaticResource NexusMutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="SALVAR"
                                Width="120"
                                Margin="0,0,12,0"
                                Style="{StaticResource NexusPrimaryButtonStyle}"
                                Click="SaveButton_Click"/>
                        <Button Content="VOLTAR AO MENU"
                                Width="150"
                                Style="{StaticResource NexusSecondaryButtonStyle}"
                                Click="BackToMenuButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock x:Name="WelcomeText"
                               Text="Bem-vindo ao clube"
                               FontSize="30"
                               FontWeight="Black"/>
                    <TextBlock Text="O universo foi criado e salvo com sucesso."
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="14"
                               Margin="0,5,0,24"/>

                    <UniformGrid Columns="4" Margin="-7,0,-7,18">
                        <Border Background="{StaticResource NexusSurfaceBrush}"
                                BorderBrush="{StaticResource NexusBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22"
                                Margin="7">
                            <StackPanel>
                                <TextBlock Text="CLUBES"
                                           Foreground="{StaticResource NexusMutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="ClubsText"
                                           Text="0"
                                           FontSize="25"
                                           FontWeight="Black"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource NexusSurfaceBrush}"
                                BorderBrush="{StaticResource NexusBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22"
                                Margin="7">
                            <StackPanel>
                                <TextBlock Text="JOGADORES"
                                           Foreground="{StaticResource NexusMutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="PlayersText"
                                           Text="0"
                                           FontSize="25"
                                           FontWeight="Black"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource NexusSurfaceBrush}"
                                BorderBrush="{StaticResource NexusBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22"
                                Margin="7">
                            <StackPanel>
                                <TextBlock Text="CAIXA"
                                           Foreground="{StaticResource NexusMutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="BalanceText"
                                           Text="R$ 0"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource NexusSurfaceBrush}"
                                BorderBrush="{StaticResource NexusBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="22"
                                Margin="7">
                            <StackPanel>
                                <TextBlock Text="REPUTAÇÃO"
                                           Foreground="{StaticResource NexusMutedBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="ReputationText"
                                           Text="0"
                                           FontSize="25"
                                           FontWeight="Black"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{StaticResource NexusSurfaceBrush}"
                            BorderBrush="{StaticResource NexusBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="NEXUS NEWS"
                                       Foreground="{StaticResource NexusAccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="HeadlineText"
                                       Text="Nova carreira criada"
                                       FontSize="22"
                                       FontWeight="Black"
                                       Margin="0,10,0,8"/>
                            <TextBlock x:Name="NewsSummaryText"
                                       Text="Seu mundo está pronto."
                                       Foreground="{StaticResource NexusMutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText"
                               Text=""
                               Foreground="{StaticResource NexusAccentBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
