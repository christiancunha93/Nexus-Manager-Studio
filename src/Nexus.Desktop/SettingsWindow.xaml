<Window x:Class="Nexus.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexus.Desktop.Controls"
        Title="Configurações"
        Width="820"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CONFIGURAÇÕES" FontSize="27" FontWeight="Black"/>
            <TextBlock Text="Preferências iniciais da experiência Nexus."
                       Foreground="{StaticResource NexusMutedBrush}"
                       Margin="0,5,0,22"/>
        </StackPanel>

        <controls:NexusCard Grid.Row="1">
            <controls:NexusCard.CardContent>
                <StackPanel>
                    <TextBlock Text="INTERFACE"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <CheckBox Content="Executar em tela cheia"
                              Foreground="{StaticResource NexusTextBrush}"
                              Margin="0,14,0,12"/>
                    <CheckBox Content="Exibir dicas de interface"
                              IsChecked="True"
                              Foreground="{StaticResource NexusTextBrush}"
                              Margin="0,0,0,12"/>
                    <CheckBox Content="Reduzir animações"
                              Foreground="{StaticResource NexusTextBrush}"/>

                    <Separator Background="{StaticResource NexusBorderBrush}" Margin="0,24"/>

                    <TextBlock Text="ÁUDIO"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                    <TextBlock Text="Volume geral"
                               Foreground="{StaticResource NexusMutedBrush}"
                               Margin="0,14,0,6"/>
                    <Slider Minimum="0" Maximum="100" Value="75"/>
                </StackPanel>
            </controls:NexusCard.CardContent>
        </controls:NexusCard>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="FECHAR"
                    Width="140"
                    Style="{StaticResource NexusSecondaryButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="CloseButton_Click"/>
            <Button Content="SALVAR"
                    Width="160"
                    Style="{StaticResource NexusPrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
