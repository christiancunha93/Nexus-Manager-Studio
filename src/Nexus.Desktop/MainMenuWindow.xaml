<Window x:Class="Nexus.Desktop.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Manager"
        Width="1500"
        Height="860"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#071017" Offset="0"/>
                <GradientStop Color="#10241C" Offset="0.48"/>
                <GradientStop Color="#081017" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#EB091017"
                BorderBrush="{StaticResource NexusBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="52,44,44,38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="NEXUS" FontSize="52" FontWeight="Black"/>
                    <TextBlock Text="MANAGER"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="2,-4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button Content="CONTINUAR CARREIRA"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="ContinueCareerButton_Click"/>
                    <Button Content="NOVA CARREIRA"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="NewCareerButton_Click"/>
                    <Button Content="CARREGAR CARREIRA"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="LoadCareerButton_Click"/>
                    <Button Content="EDITOR"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="EditorButton_Click"/>
                    <Button Content="CONFIGURAÇÕES"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="SettingsButton_Click"/>
                    <Button Content="CRÉDITOS"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="CreditsButton_Click"/>
                    <Button Content="SAIR"
                            Style="{StaticResource NexusMenuButtonStyle}"
                            Click="ExitButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="MenuStatusText"
                               Text="Cada decisão muda uma temporada."
                               Foreground="{StaticResource NexusMutedBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="SPRINT 008 • CORE UI"
                               Foreground="{StaticResource NexusAccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="72,60,64,52">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="O FUTEBOL" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="NUNCA PARA." FontSize="58" FontWeight="Black" HorizontalAlignment="Right"/>
                <TextBlock Text="Construa sua carreira. Transforme um clube. Crie uma história."
                           Foreground="{StaticResource NexusMutedBrush}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#C8111B25"
                    BorderBrush="{StaticResource NexusBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    Width="520"
                    HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="68"
                            Height="68"
                            Background="{StaticResource NexusAccentDarkBrush}"
                            CornerRadius="34"
                            Margin="0,0,18,0">
                        <TextBlock Text="CM"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ÚLTIMA CARREIRA"
                                   Foreground="{StaticResource NexusMutedBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Christian Marlon • Aurora FC"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,4,0,2"/>
                        <TextBlock Text="Temporada 2026 • Pré-temporada"
                                   Foreground="{StaticResource NexusAccentBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
